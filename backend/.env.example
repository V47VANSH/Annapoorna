# Copy to .env and fill in

# MongoDB (docker: mongodb://mongo:27017, Atlas: mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=Annapoorna

# Chat model: gemini, ollama or openai. Leave empty to use whichever is set below.
# If none are set, chat uses the built-in offline answers.
LLM_PROVIDER=
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# Gemini: key from https://aistudio.google.com/apikey
# model names: https://ai.google.dev/gemini-api/docs/models (e.g. gemini-2.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=
# set to 0 if replies come back empty (turns off "thinking" where supported)
GEMINI_THINKING_BUDGET=

# Ollama: install from https://ollama.com, then `ollama pull llama3.2`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Any OpenAI-compatible API
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Google Earth Engine (see README). Google Cloud project id:
PROJECT_ID=
# Only for servers/docker: path to a service account JSON key.
# Locally just run `uv run earthengine authenticate` once.
GEE_SERVICE_ACCOUNT_KEY=

# Optional. Without it Open-Meteo is used (no key needed).
TOMORROW_API_KEY=

# Only used by docCrud
CHROMA_HOST=
EMBEDDINGS_API_URL=
EMBEDDINGS_MODEL=openai/clip-vit-base-patch32

# Model file, defaults to backend/crop_disease_cnn_model.h5 (git lfs pull)
# MODEL_PATH=
MODEL_IMAGE_SIZE=224

# tiny, base, small, medium or large ("medium" is a ~1.4GB download)
WHISPER_MODEL_SIZE=base

# Daily report time
REPORT_CRON_HOUR=5
REPORT_CRON_MINUTE=0

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=10485760

# true disables all network calls (used by tests)
OFFLINE_MODE=false

# Use free/offline fallbacks when a service isn't configured
ALLOW_KEYLESS_FALLBACKS=true

# Demo farmer for the "skip registration" button
DEMO_MODE=true
DEMO_USER_ID=000000000000000000000001
